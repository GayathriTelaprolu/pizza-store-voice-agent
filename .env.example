# Twilio credentials (get from twilio.com - free trial gives $15 credit)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Groq API - completely free (get from console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Gmail for sending email receipts (free)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Your public URL (use ngrok for local testing - free)
# Run: .\ngrok.exe http 3000
# Then paste the https URL here
BASE_URL=https://your-ngrok-url.ngrok-free.app
